# Database (Postgres) — e.g. from Render or Neon (both have a free tier)
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Used to sign login tokens — make this a long random string
JWT_SECRET="change-this-to-a-long-random-string"

# Paystack — from your dashboard (Settings > API Keys & Webhooks) once your account is set up
PAYSTACK_SECRET_KEY=""
PAYSTACK_PUBLIC_KEY=""

# Where Paystack sends a parent's browser back after paying (your frontend's "payment result" page)
PAYSTACK_CALLBACK_URL="http://localhost:3000/payment-result"

PORT=4000
